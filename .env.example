# Core paths
SINGAPO_ROOT=/root/rivermind-data/project/singapo
RUNTIME_ROOT=/root/rivermind-data/project/runtime
# Preferred: run singapo inference with conda env name
SINGAPO_CONDA_ENV=singapo
# Fallback when SINGAPO_CONDA_ENV is empty
SINGAPO_PYTHON=/path/to/your/singapo/env/bin/python

# Backend service
API_HOST=0.0.0.0
API_PORT=8000

# If true, skip GPT graph prediction and use singapo demo/example_graph.json
DEFAULT_USE_EXAMPLE_GRAPH=true

# Prevent OpenAI client import-time failure in singapo graph_pred module.
# For MVP with use_example_graph, dummy key is acceptable.
OPENAI_API_KEY=sk-dummy

# Prefer loading DINO from local torch hub cache first.
SINGAPO_DINO_LOCAL_FIRST=true
